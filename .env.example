# Copiar a .env en el servidor (NUNCA commitear .env real) y completar con
# valores propios. .env vive junto a config/database.php: fuera de git.

# Token para _pull.php (script de emergencia de git pull manual)
DEPLOY_PULL_TOKEN=

# Token para deploy.php (webhook de auto-deploy GitHub -> cPanel)
DEPLOY_WEBHOOK_TOKEN=

# SMTP autenticado para el envío de correos (Gift Cards, Estados de Cuenta).
# Cuenta de correo real de cPanel/HostPapa (ej. no-reply@sgipro.com) — NO el
# mail() nativo de PHP, que muchos proveedores descartan en silencio.
# Si MAIL_SMTP_HOST queda vacío, el sistema usa mail() como respaldo.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_SECURE=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SGC ARGOS
