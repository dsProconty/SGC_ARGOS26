# Copiar a .env en el servidor (NUNCA commitear .env real) y completar con
# valores propios. .env vive junto a config/database.php: fuera de git.

# Token para _pull.php (script de emergencia de git pull manual)
DEPLOY_PULL_TOKEN=

# Token para deploy.php (webhook de auto-deploy GitHub -> cPanel)
DEPLOY_WEBHOOK_TOKEN=
